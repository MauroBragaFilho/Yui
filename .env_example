# ────────── INSTRUÇÃO DE CONFIGURAÇÃO ──────────
# O bot Hikari utiliza um sistema híbrido de configurações.
# 1. As configurações padrão e de comportamento estão em "src/config/config.json".
# 2. As variáveis definidas neste arquivo (.env) têm PRIORIDADE ABSOLUTA e
#    sobrescrevem qualquer valor correspondente definido no "config.json".
# 3. O uso do arquivo .env é opcional (recomendado para chaves de API e tokens sensíveis).

# ────────── CONFIGURAÇÕES OBRIGATÓRIAS (CREDENCIAIS) ──────────
DISCORD_TOKEN=seu_token_aqui
DISCORD_CLIENT_ID=seu_client_id_aqui

# ────────── WEBHOOKS (OPCIONAL) ──────────
LOG_WEBHOOK_URL=https://discord.com/api/webhooks/...
AVISOS_URL=https://discord.com/api/webhooks/...

# ────────── GOVERNANÇA E ADMINISTRAÇÃO (SOBRESCREVE CONFIG.JSON) ──────────
OWNER_ID=593372065730396160
AUTOMOD_WHITELIST=593372065730396160
APPEAL_CHANNEL_ID=1483987324869017662
PREFIX=@
BOT_NAME=Hikari
REQUIRE_TOS=true
SAVE_HISTORY=true
DEFAULT_AUTOMOD=true
AUTOMOD_MODE=both
# Enviar informações do servidor e canal (contexto de chat do Discord) no prompt da IA
SEND_ENVIRONMENT_INFO=true

# ────────── CHAVES DE API IA (SOBRESCREVE CONFIG.JSON) ──────────
GEMINI_API_KEY=suas_chave_gemini
CLOUDFLARE_ACCOUNT_ID=seu_account_id_cloudflare
CLOUDFLARE_API_TOKEN=seu_api_token_cloudflare
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
GROQ_API_KEY=sua_chave_groq_aqui
STABILITY_API_KEY=sua_chave_stability
HF_TOKEN=seu_token_huggingface
HORDE_API_KEY=0000000000
# Chaves opcionais ficam COMENTADAS até você ter a chave. Um texto-modelo (como "opcional") seria
# lido como chave de verdade e o painel mostraria "configurado" por engano.
# LM_STUDIO_API_KEY=
# HORDE_IMAGE_API_KEY=
# TOGETHER_API_KEY=
# A pesquisa na web (Brave, Tavily, SearXNG) tem seção própria mais abaixo.

# ────────── URLs E PROVEDORES (SOBRESCREVE CONFIG.JSON) ──────────
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=local-model
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HORDE_URL=https://stablehorde.net/api/v2/generate/text/async

# ────────── PESQUISA NA WEB (OPCIONAL) ──────────
# Os provedores são tentados em cadeia e o primeiro que responder vence. Provedor sem chave é pulado.
# Chave com menos de 10 caracteres é ignorada (texto-modelo não conta como configurada).
# Conversa privada (a DM de qualquer pessoa, o dono em canal privado e o app) só pesquisa se o YUI_PRIVATE_SEARCH liberar (padrão: nunca).
# O agente de pesquisa (seção própria mais abaixo) garante que todo pedido de pesquisa termine em resposta, resumo com links ou motivo.
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080
# Ordem e conjunto dos provedores (padrão: brave,tavily,searxng,duckduckgo,bing). Recomendado:
# YUI_SEARCH_PROVIDERS=tavily,brave,duckduckgo,bing
# Pesquisas por pessoa a cada hora (0 = sem limite; o dono também conta). Padrão: 5
# YUI_SEARCH_USER_PER_HOUR=5
# Teto de pesquisas por hora SOMANDO todo mundo (o dono também conta; 0 = sem teto). É o freio contra abuso e contra gastar a cota
# mensal; esgotou, a pesquisa é recusada sem chamar nenhum buscador. Padrão: 20
# YUI_SEARCH_GLOBAL_PER_HOUR=20
# Teto mensal de pesquisas por provedor com cota gratuita (0 = sem teto). Padrão: 900 cada.
# O contador fica em secrets/search-budget.json (YUI_SEARCH_BUDGET_FILE muda o caminho).
# YUI_SEARCH_MONTHLY_CAP_TAVILY=900
# YUI_SEARCH_MONTHLY_CAP_BRAVE=900
# Prazo total de uma pesquisa, em milissegundos (500 a 120000). Padrão: 12000
# YUI_SEARCH_DEADLINE_MS=12000
# Guarda o resultado de pesquisas repetidas por N minutos (0 = desligado; nunca guarda os da Brave). Padrão: 0
# YUI_SEARCH_CACHE_TTL_MIN=0
# Páginas lidas pela pesquisa: o HTML é analisado numa worker thread com prazo, para uma página hostil não travar a Yui.
# Prazo do parse de cada página, em milissegundos (20 a 30000). Estourou: a página vira "sem conteúdo" e vale o resumo da busca. Padrão: 1500
# YUI_SEARCH_PARSE_TIMEOUT_MS=1500
# Aberturas de tag que entram no parse (o resto do HTML é descartado). Padrão: 20000
# YUI_SEARCH_MAX_HTML_TAGS=20000
# Caracteres de HTML lidos de cada página antes do parse. Padrão: 300000
# YUI_SEARCH_MAX_HTML_CHARS=300000

# ────────── AGENTE DE PESQUISA (OPCIONAL) ──────────
# O CÓDIGO (e não a IA) cuida da pesquisa do começo ao fim: todo pedido termina em resposta com fontes, em resumo com links
# (sem IA) ou em uma mensagem com o motivo; "vou pesquisar isso!" sem pesquisar deixou de existir. As linhas abaixo mostram o
# PADRÃO do código; reinicie a Yui depois de editar. Detalhes: docs/content_pt/ENVIRONMENT.md (seção "Agente de pesquisa").
# Chave mestra. false volta ao jeito antigo da ferramenta search_web (só a guarda final de promessa continua). Padrão: true
# YUI_RESEARCH_ENABLED=true
# Guarda de promessa: on = a promessa sem pesquisa vira pesquisa de verdade ou aviso honesto; observe = só registra no log o que
# faria, sem mudar a resposta; off = desliga. Padrão: on
# YUI_RESEARCH_GUARD=on
# Pré-rota: pedido de pesquisa EXPLÍCITO ("pesquise o preço do PS5") é pesquisado pelo código, sem a primeira chamada à IA.
# Fica desligada no primeiro reinício; ligue (true) só depois de olhar os logs. Padrão: false
# YUI_RESEARCH_PRE_ROUTE=false
# Passos de busca por pedido (1 a 3; o 2º só roda se o 1º não achou nada) e páginas lidas depois da busca (0 a 3). Padrão: 2 / 2
# YUI_RESEARCH_MAX_STEPS=2
# YUI_RESEARCH_PAGES=2
# Prazo total do agente, em milissegundos (20000 a 180000). Estourou: resumo com os links ou o motivo. Padrão: 60000
# YUI_RESEARCH_DEADLINE_MS=60000
# true: cada passo de busca gasta 1 pesquisa do limite por pessoa e do teto global; false: só o 1º passo gasta. Padrão: true
# YUI_RESEARCH_CHARGE_ALL=true
# Mostra a linha "Fontes" (links) no fim da resposta. Padrão: true
# YUI_RESEARCH_SOURCES=true
# Pesquisa em conversa PRIVADA (o dono em DM ou em canal privado, e o app/API): off = nunca; owner = só o dono; all = qualquer
# pessoa. Valor desconhecido vale off. Padrão: off
# ATENÇÃO (privacidade): com owner ou all o texto do pedido sai do seu PC para buscadores de terceiros (Tavily, Brave, DuckDuckGo,
# Bing). Com all isso vale para QUALQUER pessoa que use uma conversa privada da Yui, e os Termos de Uso (tosHandler.js) não citam
# isso: avalie antes de liberar. Protegido nos dois modos: só pedido explícito; consulta só do texto literal da mensagem (sem
# histórico nem memória); sem dado pessoal; sem provedor anônimo; sem o texto da consulta no log.
# YUI_PRIVATE_SEARCH=off
# Lista de mods de Minecraft ("yui, me manda o link desses mods" + 5 ou mais linhas de nomes): a Yui procura cada nome na API pública do Modrinth (sem chave),
# confere o loader e a versão do Minecraft em que os mods existem juntos e devolve a lista numerada com os links (e as dependências obrigatórias).
# Em conversa PRIVADA só consulta se o YUI_PRIVATE_SEARCH liberar. Padrão: true
# YUI_MODLIST_ENABLED=true
# YUI_LISTS_ENABLED=true   (listas pessoais: "anota na lista X: itens", "mostra a lista X"; um JSON por pessoa em database/listas)
# Máximo de nomes por pedido (5 a 300). Os que passarem disso ficam de fora e a resposta avisa. Padrão: 120
# YUI_MODLIST_MAX_ITEMS=120
# Prazo total do pedido, em milissegundos (20000 a 300000). Estourou: sai o que já foi achado e o resto vira link de busca. Padrão: 120000
# YUI_MODLIST_DEADLINE_MS=120000
# Pedidos simultâneos ao Modrinth, somando todos os trabalhos (1 a 5). Padrão: 3
# YUI_MODLIST_CONCURRENCY=3

# ────────── INTEGRAÇÃO YT-DLP & FFMPEG (MULTIPLATAFORMA) ──────────
# Opcional: Deixe em branco para auto-detecção ou preencha para caminho customizado
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_COOKIES_PATH=
# Atenção: o código não lê YTDLP_EXTRA_FLAGS; as flags extras do yt-dlp são fixas em src/config/index.js (ytdlpExtraFlags).
YTDLP_EXTRA_FLAGS=--ignore-config --js-runtimes node --remote-components ejs:github
# Atualização automática do yt-dlp: uma vez logo depois de iniciar e uma vez por dia, a partir da hora abaixo.
# YTDLP_AUTO_UPDATE=true
# YTDLP_UPDATE_HOUR=4
# Cookie "arl" da sua conta Deezer (SEGREDO: não compartilhe). Necessário para baixar pelo Deezer.
DEEZER_ARL=

# ────────── DOWNLOADS DE MÍDIA (/baixar_musica, /baixar_video e ferramentas da IA) ──────────
# Link de vídeo que traz uma playlist baixa só o vídeo; playlist pura baixa só o 1º item.
# No Spotify só links de faixa funcionam (álbum, playlist e artista são recusados).
# Duração máxima, em minutos (0 = sem limite; não vale para o Modo Rádio nem para o Spotify). Padrão: 20
# YUI_DL_MAX_MINUTES=20
# Tamanho máximo do arquivo, em MB (0 = sem limite). Padrão: 200
# YUI_DL_MAX_FILESIZE_MB=200
# Tempo máximo de cada execução do yt-dlp/spotdl, em segundos (mínimo 30). Padrão: 300
# YUI_DL_TIMEOUT_SECONDS=300
# Downloads ao mesmo tempo, somando todos os usuários (0 = sem teto; máximo 50). O dono nunca é barrado pelo teto. Padrão: 3
# YUI_DL_MAX_CONCURRENT=3
# Limite de anexo do Discord, em MB. Padrão: 10 (servidor sem boost nível 2 ou 3, e conversa privada). O nível 2 usa pelo menos 50
# e o nível 3 pelo menos 100. A Yui usa 95% do valor (folga). Aceita decimal; fora de 1 a 100 é ajustado ao limite e valor inválido volta ao padrão.
# YUI_UPLOAD_LIMIT_MB=10
# MP3 acima do limite de anexo é recomprimido (192, 128 e 96 kbps, nessa ordem) até caber. Nunca no Modo Rádio.
# false desliga: aí o arquivo grande vira só um aviso de que passou do limite. Padrão: true
# YUI_AUDIO_REENCODE=true
# Prazo de cada execução do ffmpeg na recompressão, em segundos (10 a 900; fora disso vale o padrão). No máximo 2 ao mesmo tempo. Padrão: 120
# YUI_AUDIO_FIT_TIMEOUT_S=120

# ────────── DEEZER VIA DEEMIX (PYTHON) ──────────
# O deemix roda num ambiente virtual próprio (testado com Python 3.12). Para criar, na pasta do projeto:
#   py -3.12 -m venv .venv-deemix
#   .venv-deemix\Scripts\python.exe -m pip install -r requirements-deemix.txt
# Use o caminho COMPLETO do python.exe do ambiente. Sem PYTHON_PATH a Yui tenta "python" (Windows) ou "python3".
# PYTHON_PATH=D:\Projetos\Yui\.venv-deemix\Scripts\python.exe
# Tempo máximo de cada download pelo Deezer, em segundos (10 a 900). Padrão: 180
# YUI_DEEZER_TIMEOUT_S=180
# Pasta de configuração própria do deemix (opcional; padrão: %APPDATA%\deemix)
# YUI_DEEMIX_CONFIG_DIR=

# ────────── SPOTIFY VIA SPOTDL (PYTHON, OPCIONAL) ──────────
# Links de FAIXA do Spotify (open.spotify.com/track/...) são baixados pelo spotdl, que roda num ambiente Python próprio
# (testado com Python 3.12). Na pasta do projeto:
#   py -3.12 -m venv .venv-spotdl
#   .venv-spotdl\Scripts\python.exe -m pip install --only-binary=:all: -c requirements-spotdl.lock.txt -r requirements-spotdl.txt
# A Yui procura o spotdl nesta ordem: SPOTDL_PATH, .venv-spotdl\Scripts\spotdl.exe (raiz do projeto) e o PATH.
# Sem o spotdl a Yui só tenta o yt-dlp, que não baixa áudio do Spotify: o pedido falha com um aviso.
# Caminho do spotdl.exe. Precisa ser um ARQUIVO .exe (pasta, .cmd e .bat não valem). Vazio = .venv-spotdl ou PATH
# SPOTDL_PATH=D:\Projetos\Yui\.venv-spotdl\Scripts\spotdl.exe
# Bitrate do MP3 do Spotify, de 64k a 320k (outro valor volta ao padrão). Padrão: 192k
# YUI_SPOTDL_BITRATE=192k
# Detalhe do log do spotdl: WARNING, INFO ou DEBUG (use DEBUG só para investigar uma falha). Padrão: WARNING
# YUI_SPOTDL_LOG_LEVEL=WARNING
# Quantos spotdl rodam ao mesmo tempo (1 a 4). Padrão: 2
# YUI_SPOTDL_MAX_PARALLEL=2
# Atenção: nenhum nome de pasta do caminho de src/data/temp_spotify (nem das pastas acima dela) pode começar com "." ou
# terminar com ".", "*" ou "$"; senão o pedido falha cedo e o motivo vai para o log.
# O relógio do PC precisa estar certo (hora sincronizada): com a hora errada o Spotify recusa o acesso.
# A faixa pode vir numa versão diferente da do Spotify (o áudio é procurado em outro catálogo).

# ────────── MONITORAMENTO DE YOUTUBE E TWITCH (SOCIAL) ──────────
# YouTube: Google Cloud Console > enable "YouTube Data API v3" > criar API Key
YOUTUBE_API_KEY=sua_chave_youtube_data_api_v3
# Intervalo de checagem do YouTube em minutos (padrão: 5). 0 desativa.
YOUTUBE_INTERVAL_MINUTES=5
# Twitch: dev.twitch.tv/console > Criar Aplicação > Client ID + Secret
TWITCH_CLIENT_ID=seu_client_id_twitch
TWITCH_CLIENT_SECRET=seu_client_secret_twitch
# Intervalo de checagem da Twitch em minutos (padrão: 2). 0 desativa.
TWITCH_INTERVAL_MINUTES=2

# ────────── RESPOSTAS LONGAS ──────────
# Resposta com mais de 2000 caracteres é dividida em várias mensagens. Passando do limite de partes
# (ou de 20000 caracteres), vai uma introdução e o texto completo em anexo (.md). Quem é citado no texto do arquivo
# e não aparece na introdução vai na linha "Citados no arquivo" da mensagem (menção dentro de anexo não notifica).
# Máximo de mensagens por resposta (1 a 10; fora disso vale o padrão). Padrão: 4
# YUI_REPLY_MAX_PARTS=4
# Extensão do anexo com a resposta completa: md (o Discord mostra a prévia formatada) ou txt (texto cru). Padrão: md
# YUI_REPLY_ATTACH_EXT=md
# Força o limite de tokens de saída de todos os provedores (64 a 8192). Padrão: vazio (cada provedor usa o seu)
# YUI_REPLY_MAX_TOKENS=

# ────────── ANEXOS DE TEXTO E LIMITES DE ENTRADA ──────────
# A Yui lê anexos .txt, .md e .log de uma mensagem que a menciona (para texto grande, cole num arquivo). Só baixa de
# cdn.discordapp.com e media.discordapp.net, sem seguir redirecionamento, até 3 arquivos por mensagem. O conteúdo entra
# no pedido como DADO NÃO CONFIÁVEL: ela nunca obedece instruções que estejam dentro do arquivo. Padrão: ligado
# YUI_READ_TEXT_ATTACHMENTS=true
# Tamanho máximo de cada anexo lido, em KB (1 a 1024). Padrão: 100
# YUI_ATTACH_TEXT_MAX_KB=100
# Total de caracteres lidos por mensagem, somando os arquivos (500 a 50000). Passou disso: ficam o início e o fim. Padrão: 12000
# YUI_ATTACH_TEXT_MAX_CHARS=12000
# Tamanho máximo da pergunta do /yui e do "+yui perguntar", em caracteres (100 a 20000). Acima disso a Yui pede para mandar
# o texto como mensagem normal, mencionando-a, com um anexo .txt ou .md. Padrão: 4000
# YUI_ASK_MAX_CHARS=4000
# /chat_resumo: teto do log enviado à IA, em caracteres (1000 a 200000), e corte por mensagem (50 a 4000). As mensagens mais
# novas têm prioridade e o resumo avisa quando houve corte. Padrão: 20000 / 600
# YUI_SUMMARY_MAX_CHARS=20000
# YUI_SUMMARY_PER_MESSAGE=600

# ────────── FILA E PRAZO DA IA ──────────
# Pedidos esperando na fila da IA, no total (1 a 1000) e por pessoa (1 a 100). Acima disso o pedido é recusado com um aviso
# (nas menções, no máximo 1 aviso a cada 30 segundos por pessoa). Padrão: 30 / 2
# YUI_QUEUE_MAX=30
# YUI_QUEUE_MAX_PER_USER=2
# Prazo total da cadeia de provedores, em segundos (0,1 a 3600). Só vale ENTRE um provedor e o próximo (nunca corta uma
# resposta em andamento) e nunca pula o primeiro provedor que não seja o local. Padrão: 240
# YUI_AI_DEADLINE_SECONDS=240
# Conversas guardadas em RAM como histórico curto (10 a 100000); passando disso, as mais antigas saem. Padrão: 500
# YUI_HISTORY_MAX_CHANNELS=500
# ────────── CONTEXTO DAS CONVERSAS POR HORAS (OPCIONAL) ──────────
# A Yui lembra as últimas falas de cada pessoa em cada canal (um fio por pessoa), por algumas horas.
# DESLIGADO por padrão. Bancos próprios: database/memory-context.db e memory-context-personal.db.
# YUI_CONTEXT_ENABLED=false
# owner = só o dono (padrão); all = todos (avise antes nos Termos de Uso)
# YUI_CONTEXT_SCOPE=owner
# Quanto tempo cada fala fica guardada, em horas (1 a 48). Padrão: 6
# YUI_CONTEXT_TTL_HOURS=6
# Limite de caracteres do fio enviado à IA (1000 a 30000). Padrão: 6000
# YUI_CONTEXT_MAX_CHARS=6000
# Limite de falas do fio, sempre par (2 a 60). Padrão: 20
# YUI_CONTEXT_MAX_TURNS=20

# ────────── FALA DA YUI NA CALL DE VOZ (TTS LOCAL) ──────────
# Voz do Windows (SAPI): roda no seu PC, sem rede e sem custo. Só no Windows, com uma voz pt-BR instalada.
# A Yui fala resposta curta (o resto fica no chat), só a pedidos feitos por voz, nunca em conversa
# privada/sensível e nunca com o Modo Rádio ligado. Lido por src/services/tts/config.js na inicialização
# (reinicie a Yui depois de editar). Além disto, o interruptor "Resposta por Voz (TTS)" de cada servidor
# (/yui-ferramentas) vem DESLIGADO. Guia: docs/content_pt/TTS.md
# Desliga a fala por completo com false (um valor que ela não reconhece também desliga). Padrão: true
# YUI_TTS_ENABLED=true
# Provedores de voz, em ordem (hoje só existe: sapi; piper e edge ainda não existem e são ignorados). Padrão: sapi
# YUI_TTS_PROVIDERS=sapi
# Reservado para provedores de nuvem (o texto sairia do seu PC). Hoje não existe nenhum, então não muda nada. Padrão: false
# YUI_TTS_CLOUD=false              (true = voz neural da nuvem; o texto falado sai do PC; se falhar, volta para a voz do Windows)
# Azure Speech (oficial; opcional): crie o recurso "Speech" (faixa gratuita F0) e cole a chave e a região. Passo a passo em docs/content_pt/TTS.md.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth
# YUI_TTS_AZURE_VOICE=pt-BR-ThalitaMultilingualNeural
# YUI_TTS_AZURE_STYLE=
# YUI_TTS_AZURE_RATE=+0%
# YUI_TTS_AZURE_PITCH=+0Hz
# YUI_TTS_AZURE_MAX_CHARS_PER_MONTH=450000
# YUI_TTS_EDGE_VOICE=pt-BR-FranciscaNeural   (ou pt-BR-ThalitaNeural, mais jovem)
# YUI_TTS_EDGE_RATE=-4%
# YUI_TTS_EDGE_PITCH=+0Hz
# YUI_TTS_EDGE_MAX_CHARS_PER_DAY=100000
# true libera ferramentas por voz (baixar, buscar, gerar imagem...). Padrão: false (voz só conversa; a ferramenta pedida vira "Isso eu faço só pelo chat.")
# YUI_VOICE_TOOLS=false
# Nome (ou parte do nome) da voz SAPI. Vazio = a primeira voz pt-BR instalada
# YUI_TTS_SAPI_VOICE=
# Velocidade da voz, de -10 (lenta) a 10 (rápida). Padrão: 0
# YUI_TTS_SAPI_RATE=0
# Quanto ela fala por resposta: caracteres (60 a 600), frases (1 a 6), caracteres por frase (60 a 400)
# e segundos (5 a 60). Padrão: 220 / 3 / 160 / 25
# YUI_TTS_MAX_CHARS=220
# YUI_TTS_MAX_SENTENCES=3
# YUI_TTS_MAX_SENTENCE_CHARS=160
# YUI_TTS_MAX_SECONDS=25
# Resposta que demorou mais que isso para ficar pronta não é mais falada (5 a 300 s). Padrão: 30
# YUI_TTS_STALE_SECONDS=30
# Limites de uso: intervalo entre falas para a mesma pessoa (0 a 120 s), falas por minuto por pessoa (1 a 60),
# por servidor (1 a 120) e no total (1 a 240), segundos de fala por servidor a cada 10 min (10 a 1200)
# e fila por servidor (1 a 10). Padrão: 6 / 5 / 8 / 12 / 120 / 3
# YUI_TTS_USER_GAP_SECONDS=6
# YUI_TTS_USER_PER_MIN=5
# YUI_TTS_GUILD_PER_MIN=8
# YUI_TTS_GLOBAL_PER_MIN=12
# YUI_TTS_GUILD_SECONDS_PER_10MIN=120
# YUI_TTS_QUEUE_MAX=3
# Interrupção: a Yui para de falar quando alguém fala por cima por mais de N ms (200 a 5000). Padrão: true / 800
# YUI_TTS_BARGE_IN=true
# YUI_TTS_BARGE_IN_MS=800
# Anti-eco: margem em ms em volta da fala da Yui em que o áudio captado é descartado antes de ser transcrito (0 a 10000). Padrão: 1500
# YUI_TTS_ECHO_GUARD_MS=1500
# Minutos sem falar até o processo da voz ser encerrado (1 a 240). Padrão: 10
# YUI_TTS_IDLE_MINUTES=10
# Prazos do SAPI em ms: normal (1000 a 30000) e primeira fala após a partida (3000 a 60000). Padrão: 4000 / 15000
# YUI_TTS_SAPI_TIMEOUT_MS=4000
# YUI_TTS_SAPI_COLD_TIMEOUT_MS=15000
# Arquivo com as regras de estilo da resposta falada (dentro do projeto, .md ou .txt; relido quando muda). Padrão: persona/yui-voz.md
# YUI_PERSONA_VOICE_FILE=persona/yui-voz.md

# ────────── PERSONALIDADE (PROMPT DO SISTEMA) ──────────
SYSTEM_PROMPT=""
