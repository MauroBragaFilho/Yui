# Servidor da Yui usado por este app. O usuário não digita endereço: ele vem daqui, na hora do build.
# Copie para ".env" (que fica fora do Git) e ajuste. Não coloque endereço real neste arquivo de exemplo.

# Android, UMA versão para casa e para fora: lista de endereços separados por vírgula, em ordem de preferência
# (o primeiro é o da rede local; os seguintes são reserva, como o do Tailscale). No máximo 4; só http/https, sem usuário nem senha.
# O app usa o primeiro que responder e lembra o último que funcionou.
EXPO_PUBLIC_YUI_SERVER_URLS=http://<ip-da-rede-local>:3939,http://<ip-do-tailscale>:3939

# Android, um endereço só (usado quando a lista acima não existe): endereço HTTPS da API publicada na sua tailnet (tailscale serve).
# EXPO_PUBLIC_YUI_SERVER_URL=https://seu-pc.sua-tailnet.ts.net:3939

# Prova de IDENTIDADE do servidor (Android): a chave PÚBLICA Ed25519 da Yui, em base64 (a que `node scripts/gerar-identidade-yui.mjs` imprime no servidor). Com ela o app só envia senha e token a um
# servidor que provar, com uma assinatura, ter a chave privada (que fica só no servidor). É pública: pode estar no APK. Não coloque a chave real neste arquivo de exemplo. A web não usa.
# EXPO_PUBLIC_YUI_IDENTIDADE_PUBKEY=<chave-publica-em-base64>

# Web (opcional): porta da API quando o app é servido pelo mesmo PC (padrão 3939). A lista não vale na web.
# EXPO_PUBLIC_YUI_API_PORT=3939
